---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Payments">
  <div class="mb-12">
    <div class="flex flex-wrap gap-4">
      {['Current Year', 'Previous 1Y', 'Previous Month', 'All Time'].map(label => (
        <button class="px-6 py-2 border border-[#1b2a23] text-[10px] font-bold uppercase tracking-[0.2em] hover:bg-[#1b2a23] hover:text-white transition-all cursor-pointer">
          {label}
        </button>
      ))}
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
    <div class="bg-white border border-[#1b2a23]/5 p-8 shadow-sm">
      <p class="text-[#1b2a23]/40 text-[10px] font-bold uppercase tracking-widest mb-4">Total Paid</p>
      <p class="text-5xl text-[#1b2a23] font-['EB_Garamond']">$0.00</p>
    </div>
    <div class="bg-white border border-[#1b2a23]/5 p-8 shadow-sm">
      <p class="text-[#1b2a23]/40 text-[10px] font-bold uppercase tracking-widest mb-4">Total Pending</p>
      <p class="text-5xl text-[#1b2a23] font-['EB_Garamond']">$0.00</p>
    </div>
    <div class="bg-white border border-[#1b2a23]/5 p-8 shadow-sm">
      <p class="text-[#1b2a23]/40 text-[10px] font-bold uppercase tracking-widest mb-4">Average/Shoot</p>
      <p class="text-5xl text-[#1b2a23] font-['EB_Garamond']">$0.00</p>
    </div>
  </div>

  <div class="bg-white border border-[#1b2a23]/5 p-12 shadow-sm overflow-x-auto">
    <header class="mb-12 border-b border-[#1b2a23]/5 pb-8">
        <h3 class="font-['Plus_Jakarta_Sans'] text-[10px] font-bold uppercase tracking-[0.2em] text-[#1b2a23]/50">Recent Transactions</h3>
    </header>
    <table class="w-full text-left border-collapse">
      <thead>
        <tr class="border-b border-[#1b2a23]/10">
          <th class="py-4 font-['Plus_Jakarta_Sans'] text-[10px] font-bold uppercase tracking-widest text-[#1b2a23]/40">Date</th>
          <th class="py-4 font-['Plus_Jakarta_Sans'] text-[10px] font-bold uppercase tracking-widest text-[#1b2a23]/40">Client</th>
          <th class="py-4 font-['Plus_Jakarta_Sans'] text-[10px] font-bold uppercase tracking-widest text-[#1b2a23]/40">Amount</th>
          <th class="py-4 font-['Plus_Jakarta_Sans'] text-[10px] font-bold uppercase tracking-widest text-[#1b2a23]/40 text-right">Status</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td colspan="4" class="py-20 text-center">
            <p class="text-[#1b2a23]/30 font-['EB_Garamond'] italic text-xl">No transactions found.</p>
            <span class="text-[10px] font-bold uppercase tracking-widest text-[#1b2a23]/20 mt-2 block">Connect to Unscripted or Stripe</span>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</Layout>

<script>
  // Basic toggle logic
  const buttons = document.querySelectorAll('button');
  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      buttons.forEach(b => b.classList.remove('bg-[#1b2a23]', 'text-white'));
      btn.classList.add('bg-[#1b2a23]', 'text-white');
    });
  });
</script>
