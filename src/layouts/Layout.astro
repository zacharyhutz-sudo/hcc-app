---
import '../styles/global.css';
import { LayoutDashboard, Users, FolderKanban, Banknote } from 'lucide-astro';

interface Props {
  title: string;
}

const { title } = Astro.props;

const navItems = [
  { href: '/hcc-app/', label: 'Dashboard', icon: LayoutDashboard },
  { href: '/hcc-app/clients', label: 'Clients', icon: Users },
  { href: '/hcc-app/projects', label: 'Projects', icon: FolderKanban },
  { href: '/hcc-app/payments', label: 'Payments', icon: Banknote },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/hcc-app/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | HCC App</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Della+Respira&family=EB+Garamond:ital,wght@0,400..800;1,400..800&family=Great+Vibes&family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&display=swap" rel="stylesheet">
  </head>
  <body class="min-h-screen flex flex-col md:flex-row bg-[#f7faf8] noise">
    <nav class="w-full md:w-64 bg-white border-b md:border-b-0 md:border-r border-[#1b2a23]/10 p-6 flex flex-col gap-8 md:gap-12">
      <div class="flex justify-between items-center">
        <h1 class="text-3xl text-[#1b2a23] font-['EB_Garamond']">HCC App</h1>
      </div>
      <ul class="flex md:flex-col flex-1 justify-around md:justify-start gap-4 md:gap-6">
        {navItems.map(({ href, label, icon: Icon }) => (
          <li>
            <a href={href} class="flex items-center gap-3 text-[#51645c] hover:text-[#7ea493] transition-colors">
              <Icon size={18} />
              <span class="font-['Plus_Jakarta_Sans'] text-[10px] md:text-xs font-bold uppercase tracking-widest">{label}</span>
            </a>
          </li>
        ))}
      </ul>
      <footer class="mt-auto pt-8 border-t border-[#1b2a23]/5 hidden md:block">
        <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-[#1b2a23]/40">
          Design by <br/> Hutzell Creative Co
        </p>
      </footer>
    </nav>
    <main class="flex-1 p-6 md:p-12 overflow-y-auto selection:bg-[#7ea493]/20">
      <header class="mb-16">
        <h2 class="text-5xl md:text-7xl font-['EB_Garamond'] italic tracking-tighter mb-4">{title}</h2>
        <div class="w-24 h-px bg-[#1b2a23]/20"></div>
      </header>
      <slot />
      <footer class="mt-20 py-8 border-t border-[#1b2a23]/5 md:hidden">
        <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-[#1b2a23]/40">
          Design by Hutzell Creative Co
        </p>
      </footer>
    </main>
  </body>
</html>
